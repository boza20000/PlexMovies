<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <changeSet id="TSEAP-208-2" author="boristsvetkov">
        <createTable tableName="award">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_award"/>
            </column>
            <column name="award" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-3" author="boristsvetkov">
        <createTable tableName="award_media_item">
            <column name="award_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_award_media_item"/>
            </column>
            <column name="media_item_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-4" author="boristsvetkov">
        <createTable tableName="episode">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_episode"/>
            </column>
            <column name="season_id" type="BIGINT"/>
            <column name="episode_number" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-5" author="boristsvetkov">
        <createTable tableName="genre">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_genre"/>
            </column>
            <column name="genre" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-6" author="boristsvetkov">
        <createTable tableName="genre_media_item">
            <column name="genre_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_genre_media_item"/>
            </column>
            <column name="media_item_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-7" author="boristsvetkov">
        <createTable tableName="language">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_language"/>
            </column>
            <column name="language" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="stream_type" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-8" author="boristsvetkov">
        <createTable tableName="language_media_item">
            <column name="language_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_language_media_item"/>
            </column>
            <column name="media_item_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-9" author="boristsvetkov">
        <createTable tableName="media_item">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_media_item"/>
            </column>
            <column name="item_type" type="VARCHAR(31)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)"/>
            <column name="description" type="VARCHAR(255)"/>
            <column name="rating" type="INT"/>
            <column name="release_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="imdb_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-10" author="boristsvetkov">
        <createTable tableName="people_media_item">
            <column name="media_item_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_people_media_item"/>
            </column>
            <column name="people_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-11" author="boristsvetkov">
        <createTable tableName="person">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_person"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-14" author="boristsvetkov">
        <createTable tableName="season">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_season" foreignKeyName="fk_season_on_media_item" references="media_item(id)"/>
            </column>
            <column name="series_id" type="BIGINT"/>
            <column name="season_number" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="date" type="DATE"/>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-15" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="season_id" baseTableName="episode"
                                 constraintName="FK_EPISODE_ON_SEASON" referencedColumnNames="id"
                                 referencedTableName="season"/>
    </changeSet>
    <changeSet id="TSEAP-208-16" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="series_id" baseTableName="season" constraintName="FK_SEASON_ON_SERIES"
                                 referencedColumnNames="id" referencedTableName="media_item"/>
    </changeSet>
    <changeSet id="TSEAP-208-17" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="award_id" baseTableName="award_media_item"
                                 constraintName="fk_awamedite_on_award_entity" referencedColumnNames="id"
                                 referencedTableName="award"/>
    </changeSet>
    <changeSet id="TSEAP-208-18" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="media_item_id" baseTableName="award_media_item"
                                 constraintName="fk_awamedite_on_media_item_entity" referencedColumnNames="id"
                                 referencedTableName="media_item"/>
    </changeSet>
    <changeSet id="TSEAP-208-19" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="genre_id" baseTableName="genre_media_item"
                                 constraintName="fk_genmedite_on_genre_entity" referencedColumnNames="id"
                                 referencedTableName="genre"/>
    </changeSet>
    <changeSet id="TSEAP-208-20" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="media_item_id" baseTableName="genre_media_item"
                                 constraintName="fk_genmedite_on_media_item_entity" referencedColumnNames="id"
                                 referencedTableName="media_item"/>
    </changeSet>
    <changeSet id="TSEAP-208-21" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="language_id" baseTableName="language_media_item"
                                 constraintName="fk_lanmedite_on_language_entity" referencedColumnNames="id"
                                 referencedTableName="language"/>
    </changeSet>
    <changeSet id="TSEAP-208-22" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="media_item_id" baseTableName="language_media_item"
                                 constraintName="fk_lanmedite_on_media_item_entity" referencedColumnNames="id"
                                 referencedTableName="media_item"/>
    </changeSet>
    <changeSet id="TSEAP-208-23" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="media_item_id" baseTableName="people_media_item"
                                 constraintName="fk_peomedite_on_media_item_entity" referencedColumnNames="id"
                                 referencedTableName="media_item"/>
    </changeSet>
    <changeSet id="TSEAP-208-24" author="boristsvetkov">
        <addForeignKeyConstraint baseColumnNames="people_id" baseTableName="people_media_item"
                                 constraintName="fk_peomedite_on_person_entity" referencedColumnNames="id"
                                 referencedTableName="person"/>
    </changeSet>
    <changeSet id="TSEAP-208-26" author="boristsvetkov">
        <createTable tableName="movie">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_movies" foreignKeyName="fk_media_item_base" references="media_item(id)"/>
            </column>
            <column name="year" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="duration" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="TSEAP-208-27" author="boristsvetkov">
        <createTable tableName="series">
            <column name="id" type="BIGINT" >
                <constraints primaryKey="true" primaryKeyName="pk_series" foreignKeyName="fk_media_item_series_base" references="media_item(id)"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="TSEAP-208-28" author="boristsvetkov">
      <addForeignKeyConstraint baseTableName="episode" baseColumnNames="id" constraintName="fk_episode_on_media_item" referencedTableName="media_item"
                               referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="TSEAP-208-29" author="boristsvetkov">
        <addUniqueConstraint tableName="genre" columnNames="genre"/>
        <addUniqueConstraint tableName="award" columnNames="award"/>
        <addUniqueConstraint tableName="language" columnNames="language"/>
        <addUniqueConstraint tableName="person" columnNames="name,role"/>
    </changeSet>

    <changeSet id="TSEAP-208-30" author="boristsvetkov">
        <modifyDataType tableName="media_item" columnName="description" newDataType="text"/>
    </changeSet>

    <changeSet id="TSEAP-208-31" author="boristsvetkov">
        <addNotNullConstraint tableName="media_item" columnName="release_date"/>
    </changeSet>

</databaseChangeLog>